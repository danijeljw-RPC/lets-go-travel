{
  "realm": "rtgt",
  "displayName": "readytogo.travel local development",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "roles": {
    "realm": [
      {
        "name": "support-agent",
        "description": "Grants access to the privileged support ticket console."
      }
    ]
  },
  "clients": [
    {
      "clientId": "rtgt-api",
      "name": "RTGT API",
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "rtgt-web",
      "name": "RTGT Blazor Web",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5081/signin-oidc",
        "http://localhost:5081/signout-callback-oidc"
      ],
      "webOrigins": [
        "http://localhost:5081"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5081/*"
      },
      "protocolMappers": [
        {
          "name": "rtgt-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "rtgt-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
